{
    "name": "app",
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "dev": "bun --bun vite dev",
        "build": "bun --bun vite build",
        "preview": "bun --bun vite preview",
        "prepare": "bun --bun svelte-kit sync",
        "check": "bun --bun svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "format": "bun --bun prettier --write .",
        "db:generate": "bun --bun drizzle-kit generate",
        "db:studio": "bun --bun drizzle-kit studio"
    },
    "imports": {
        "#lib/*": "./src/lib/*"
    },
    "dependencies": {
        "drizzle-orm": "^1.0.0-rc.5",
        "valibot": "^1.5.0"
    },
    "devDependencies": {
        "@sveltejs/adapter-bun": "^1.0.0-next.2",
        "@sveltejs/kit": "^3.0.0-next.27",
        "@sveltejs/vite-plugin-svelte": "^7.3.0",
        "bun-types": "^1.4.2",
        "drizzle-kit": "^1.0.0-rc.5",
        "prettier": "^3.9.8",
        "prettier-plugin-svelte": "^4.1.1",
        "svelte": "^5.57.0",
        "svelte-check": "^4.7.6",
        "typescript": "^6.0.3",
        "vite": "^8.3.0"
    },
    "prettier": {
        "printWidth": 160,
        "semi": false,
        "singleQuote": false,
        "tabWidth": 4,
        "useTabs": false,
        "trailingComma": "all",
        "plugins": [
            "prettier-plugin-svelte"
        ],
        "overrides": [
            {
                "files": "*.svelte",
                "options": {
                    "parser": "svelte"
                }
            }
        ]
    }
}
