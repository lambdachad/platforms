{
    "name": "app",
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "dev": "vite dev",
        "build": "vite build",
        "preview": "vite preview",
        "prepare": "svelte-kit sync",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "format": "prettier --write ."
    },
    "dependencies": {
        "valibot": "^1.5.0"
    },
    "devDependencies": {
        "@sveltejs/adapter-bun": "^1.0.0-next.2",
        "@sveltejs/kit": "^3.0.0-next.27",
        "@sveltejs/vite-plugin-svelte": "^7.3.0",
        "bun-types": "^1.4.2",
        "prettier": "^3.9.8",
        "prettier-plugin-svelte": "^4.1.1",
        "svelte": "^5.57.0",
        "svelte-check": "^4.7.6",
        "typescript": "^6.0.3",
        "vite": "^8.3.0"
    },
    "prettier": {
        "printWidth": 160,
        "semi": false,
        "singleQuote": false,
        "tabWidth": 4,
        "useTabs": false,
        "trailingComma": "all",
        "plugins": [
            "prettier-plugin-svelte"
        ],
        "overrides": [
            {
                "files": "*.svelte",
                "options": {
                    "parser": "svelte"
                }
            }
        ]
    },
    "imports": {
        "#lib/*": "./src/lib/*"
    }
}
